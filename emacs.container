[Unit]
Description=Emacs
After=network-online.target

[Container]
Image=ghcr.io/danrobi11/my-emacs-fedora-docker-image:latest
Network=host
Exec=sleep infinity
UserNS=keep-id
Environment=HOME=/home/danrobi
SecurityLabelDisable=true

Volume=/var/home/danrobi:/home/danrobi

[Service]
Restart=on-failure
TimeoutStartSec=600

[Install]
WantedBy=default.target
