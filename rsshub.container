[Unit]
Description=RSSHub
After=network-online.target

[Container]
Image=docker.io/diygod/rsshub:chromium-bundled
PublishPort=1200:1200
EnvironmentFile=/var/home/danrobi/.config/rsshub/env
Network=host
# GlobalArgs=--storage-opt=additionalimagestore=/usr/lib/bootc/storage
UserNS=keep-id
Environment=HOME=/home/danrobi
SecurityLabelDisable=true

Volume=/var/home/danrobi/.config/rsshub:/home/danrobi/.config/rsshub

[Service]
Restart=on-failure
TimeoutStartSec=600

# [Install]
# WantedBy=default.target
